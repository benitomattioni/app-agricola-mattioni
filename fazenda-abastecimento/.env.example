# Copie este arquivo para ".env" ao rodar localmente.
# No Render, essas variáveis são configuradas na aba "Environment" do serviço
# (o DATABASE_URL é preenchido automaticamente quando você conecta o Postgres).

DATABASE_URL=postgres://usuario:senha@host:5432/banco
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande-e-secreta
PORT=3000

# Chave da API da Anthropic (console.anthropic.com), usada para ler os
# números de litros e horímetro nas fotos enviadas no abastecimento.
# É uma conta separada da sua assinatura do Claude.ai, com cobrança por uso.
# Se você deixar essa variável em branco, o app funciona normalmente, só
# sem a leitura automática das fotos (a pessoa digita os valores na mão).
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-4-5-20251001

# A partir de quantos litros de diesel o app avisa o administrador.
LOW_STOCK_THRESHOLD_LITERS=1000

# E-mail: usado tanto pro alerta de estoque de diesel baixo quanto pela
# recuperação de senha ("Esqueci minha senha" na tela de login).
# Exemplo usando Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER=seuemail@gmail.com, SMTP_PASS=senha de app
# (não é a senha normal da conta — gere uma "senha de app" em
# myaccount.google.com/apppasswords). Sem essas variáveis, o app funciona
# normal, mas ninguém recebe e-mail de estoque baixo nem consegue
# recuperar a senha sozinho (nesse caso, seria preciso resetar direto no
# banco de dados).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=

# Notificação push no celular. Gere o par de chaves rodando, uma única vez,
# "npx web-push generate-vapid-keys" (no seu computador ou no shell do
# Render) e cole os valores abaixo. Deixe em branco para desativar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Leitura automática da balança (câmera + peso, via Raspberry Pi ou outro
# dispositivo). Esse token é uma senha fixa que o dispositivo manda no
# cabeçalho "X-Device-Token" ao chamar POST /api/scale/scan — não é uma
# conta de usuário, é só pra autenticar a máquina. Invente uma string
# longa e aleatória (ex.: gere uma com "openssl rand -hex 32"). Deixe em
# branco para desativar essa rota (ela responde 503 sem isso configurado).
SCALE_DEVICE_TOKEN=
